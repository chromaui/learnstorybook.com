{
  "name": "learnstorybook.com",
  "description": "Learn Storybook",
  "version": "1.0.0",
  "author": "Tom Coleman <tom@chromatic.com>, Dominic Nguyen <dom@chromatic.com>",
  "dependencies": {
    "@docsearch/css": "^3.9.0",
    "@storybook/components-marketing": "3.3.0",
    "@storybook/design-system": "7.15.19",
    "@storybook/theming": "^6.5.16",
    "cheerio": "^1.2.0",
    "formik": "^2.4.9",
    "framer-motion": "7.10.3",
    "gatsby": "^5.16.1",
    "gatsby-plugin-google-analytics": "^5.16.0",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-plausible": "patch:gatsby-plugin-plausible@npm%3A0.0.7#~/.yarn/patches/gatsby-plugin-plausible-npm-0.0.7-ad2b8de98c.patch",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-code-titles": "^1.1.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "lodash": "^4.18.1",
    "pluralize": "^8.0.0",
    "polished": "^4.3.1",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-github-button": "^0.1.11",
    "react-helmet": "^6.1.0"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1 <26"
  },
  "scripts": {
    "build": "yarn build:prepare && gatsby build --prefix-paths && yarn build:finish",
    "build-storybook": "yarn storybook:prepare && storybook build",
    "build:finish": "bash scripts/move-to-build.sh",
    "build:prepare": "yarn extract-sb-docs-metadata && mkdir -p public/tutorials",
    "clean": "gatsby clean",
    "dev": "gatsby develop",
    "extract-sb-docs-metadata": "./scripts/extract-sb-docs-metadata.sh",
    "format": "prettier --write . && eslint --fix .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "postinstall": "husky",
    "serve": "gatsby serve --prefix-paths",
    "storybook": "yarn storybook:prepare && storybook dev -p 6006",
    "storybook:prepare": "yarn extract-sb-docs-metadata && gatsby build --prefix-paths",
    "test": "node --test"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write"
    ],
    "*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-react": "^7.29.7",
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-remove-graphql-queries": "^5.16.0",
    "babel-preset-gatsby": "^3.16.0",
    "chromatic": "^18.14.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.6",
    "vite": "^8.3.6"
  },
  "packageManager": "yarn@4.18.1"
}
